import React, { useState, useEffect } from 'react';
import { LineChart, Line, BarChart, Bar, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, PieChart, Pie, Cell } from 'recharts';
import { TrendingUp, TrendingDown, DollarSign, Users, MessageSquare, Target, Sparkles, Phone, CheckCircle, Edit, Trash2, Calendar, Tag, Sun, Moon, User } from 'lucide-react';

export default function SalesMetricsTracker() {
  const [metrics, setMetrics] = useState([]);
  const [showForm, setShowForm] = useState(false);
  const [loading, setLoading] = useState(true);
  const [aiInsights, setAiInsights] = useState(null);
  const [loadingInsights, setLoadingInsights] = useState(false);
  const [viewMode, setViewMode] = useState('all');
  const [selectedMonth, setSelectedMonth] = useState('');
  const [editingId, setEditingId] = useState(null);
  const [showDataTable, setShowDataTable] = useState(false);
  const [darkMode, setDarkMode] = useState(false);
  const [userName, setUserName] = useState('');
  const [showNameInput, setShowNameInput] = useState(false);
  const [chartViewMode, setChartViewMode] = useState('weekly'); // weekly, monthly, quarterly, yearly
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [loginPassword, setLoginPassword] = useState('');
  const [setupPassword, setSetupPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [isFirstTime, setIsFirstTime] = useState(false);
  const [loginError, setLoginError] = useState('');
  
  const [formData, setFormData] = useState({
    month: new Date().toLocaleString('default', { month: 'long' }),
    week: '1',
    year: new Date().getFullYear().toString(),
    qualifiedConversations: '',
    bookedCalls: '',
    closedDeals: '',
    cashCollected: '',
    leadSource: 'Inbound'
  });

  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const weeks = ['1', '2', '3', '4', '5'];
  const years = ['2024', '2025', '2026'];
  const leadSources = ['Inbound', 'Outbound', 'Referral'];
  const quarters = {
    Q1: ['January', 'February', 'March'],
    Q2: ['April', 'May', 'June'],
    Q3: ['July', 'August', 'September'],
    Q4: ['October', 'November', 'December']
  };

  const greetings = [
    "Let's crush those numbers today",
    "Ready to make it happen",
    "Time to scale new heights",
    "Your success story starts here",
    "Let's turn data into growth",
    "Building momentum, one deal at a time",
    "Excellence is the standard",
    "Let's optimize for greatness"
  ];

  const sourceColors = {
    Inbound: '#FF6B35',
    Outbound: '#9B59B6',
    Referral: '#2ECC71'
  };

  useEffect(() => {
    loadMetrics();
    loadUserName();
    loadTheme();
    checkAuthentication();
  }, []);

  const checkAuthentication = async () => {
    try {
      const savedPassword = await window.storage.get('dashboard-password');
      if (!savedPassword || !savedPassword.value) {
        setIsFirstTime(true);
      }
    } catch (error) {
      setIsFirstTime(true);
    }
  };

  const handleSetupPassword = async () => {
    if (setupPassword.length < 6) {
      setLoginError('Password must be at least 6 characters');
      return;
    }
    if (setupPassword !== confirmPassword) {
      setLoginError('Passwords do not match');
      return;
    }
    try {
      await window.storage.set('dashboard-password', setupPassword);
      setIsAuthenticated(true);
      setIsFirstTime(false);
      setLoginError('');
    } catch (error) {
      setLoginError('Error setting up password');
    }
  };

  const handleLogin = async () => {
    try {
      const savedPassword = await window.storage.get('dashboard-password');
      if (savedPassword && savedPassword.value === loginPassword) {
        setIsAuthenticated(true);
        setLoginError('');
        setLoginPassword('');
      } else {
        setLoginError('Incorrect password');
      }
    } catch (error) {
      setLoginError('Error logging in');
    }
  };

  const handleLogout = () => {
    setIsAuthenticated(false);
    setLoginPassword('');
  };

  const loadUserName = async () => {
    try {
      const result = await window.storage.get('user-name');
      if (result && result.value) {
        setUserName(result.value);
      }
    } catch (error) {
      console.log('No user name saved');
    }
  };

  const saveUserName = async (name) => {
    try {
      await window.storage.set('user-name', name);
      setUserName(name);
      setShowNameInput(false);
    } catch (error) {
      console.error('Error saving name:', error);
    }
  };

  const loadTheme = async () => {
    try {
      const result = await window.storage.get('dark-mode');
      if (result && result.value) {
        setDarkMode(result.value === 'true');
      }
    } catch (error) {
      console.log('No theme preference saved');
    }
  };

  const toggleTheme = async () => {
    const newMode = !darkMode;
    setDarkMode(newMode);
    try {
      await window.storage.set('dark-mode', newMode.toString());
    } catch (error) {
      console.error('Error saving theme:', error);
    }
  };

  const getRandomGreeting = () => {
    return greetings[Math.floor(Math.random() * greetings.length)];
  };

  const loadMetrics = async () => {
    try {
      const result = await window.storage.get('sales-metrics');
      if (result && result.value) {
        const loadedMetrics = JSON.parse(result.value);
        const migratedMetrics = loadedMetrics.map((m, index) => {
          if (!m.month || !m.week || !m.year) {
            const date = new Date(m.week || m.weekLabel || new Date());
            return {
              ...m,
              id: m.id || Date.now() + index,
              month: date.toLocaleString('default', { month: 'long' }),
              week: '1',
              year: date.getFullYear().toString(),
              weekLabel: m.weekLabel || `${date.toLocaleString('default', { month: 'long' })} Week 1, ${date.getFullYear()}`,
              qualifiedConversations: m.qualifiedConversations || 0,
              bookedCalls: m.bookedCalls || 0,
              closedDeals: m.closedDeals || 0,
              bookingRate: m.bookingRate || 0,
              conversionRate: m.conversionRate || 0,
              cashCollected: m.cashCollected || 0,
              leadSource: m.leadSource || 'Inbound'
            };
          }
          return {
            ...m,
            id: m.id || Date.now() + index,
            qualifiedConversations: m.qualifiedConversations || 0,
            bookedCalls: m.bookedCalls || 0,
            closedDeals: m.closedDeals || 0,
            bookingRate: m.bookingRate || 0,
            conversionRate: m.conversionRate || 0,
            cashCollected: m.cashCollected || 0,
            leadSource: m.leadSource || 'Inbound'
          };
        });
        setMetrics(migratedMetrics);
        saveMetrics(migratedMetrics);
      }
    } catch (error) {
      console.log('Error loading metrics:', error);
    } finally {
      setLoading(false);
    }
  };

  const saveMetrics = async (newMetrics) => {
    try {
      await window.storage.set('sales-metrics', JSON.stringify(newMetrics));
    } catch (error) {
      console.error('Error saving metrics:', error);
    }
  };

  const calculateRates = (qualified, booked, closed) => {
    const bookingRate = qualified > 0 ? (booked / qualified * 100) : 0;
    const conversionRate = booked > 0 ? (closed / booked * 100) : 0;
    return { bookingRate, conversionRate };
  };

  const formatWeekLabel = (month, week, year) => {
    return `${month} Week ${week}, ${year}`;
  };

  const formatChartLabel = (metric) => {
    const monthShort = metric.month.substring(0, 3);
    const yearShort = metric.year.substring(2);
    return `W${metric.week}`;
  };

  const formatAggregatedLabel = (label) => {
    // For monthly: "January 2025" -> "Jan 25"
    if (label.includes(' ') && !label.includes('Q') && !label.includes('Week')) {
      const parts = label.split(' ');
      const month = parts[0].substring(0, 3);
      const year = parts[1].substring(2);
      return `${month} ${year}`;
    }
    // For quarterly: "Q1 2025" -> "Q1 '25"
    if (label.includes('Q')) {
      const parts = label.split(' ');
      return `${parts[0]} '${parts[1].substring(2)}`;
    }
    // For yearly: "2025" -> "'25"
    if (label.length === 4 && !isNaN(label)) {
      return `'${label.substring(2)}`;
    }
    return label;
  };

  const handleSubmit = () => {
    if (!formData.month || !formData.week || !formData.year || !formData.qualifiedConversations || 
        !formData.bookedCalls || !formData.closedDeals || !formData.cashCollected || !formData.leadSource) {
      alert('Please fill in all fields');
      return;
    }

    const qualified = parseInt(formData.qualifiedConversations);
    const booked = parseInt(formData.bookedCalls);
    const closed = parseInt(formData.closedDeals);
    const { bookingRate, conversionRate } = calculateRates(qualified, booked, closed);

    const weekLabel = formatWeekLabel(formData.month, formData.week, formData.year);

    const newMetric = {
      id: editingId || Date.now(),
      month: formData.month,
      week: formData.week,
      year: formData.year,
      weekLabel: weekLabel,
      qualifiedConversations: qualified,
      bookedCalls: booked,
      closedDeals: closed,
      bookingRate: parseFloat(bookingRate.toFixed(2)),
      conversionRate: parseFloat(conversionRate.toFixed(2)),
      cashCollected: parseFloat(formData.cashCollected),
      leadSource: formData.leadSource
    };
    
    let updatedMetrics;
    if (editingId) {
      updatedMetrics = metrics.map(m => m.id === editingId ? newMetric : m);
    } else {
      updatedMetrics = [...metrics, newMetric];
    }
    
    updatedMetrics.sort((a, b) => {
      if (a.year !== b.year) return parseInt(a.year) - parseInt(b.year);
      const monthDiff = months.indexOf(a.month) - months.indexOf(b.month);
      if (monthDiff !== 0) return monthDiff;
      return parseInt(a.week) - parseInt(b.week);
    });
    
    setMetrics(updatedMetrics);
    saveMetrics(updatedMetrics);
    
    setFormData({
      month: new Date().toLocaleString('default', { month: 'long' }),
      week: '1',
      year: new Date().getFullYear().toString(),
      qualifiedConversations: '',
      bookedCalls: '',
      closedDeals: '',
      cashCollected: '',
      leadSource: 'Inbound'
    });
    setShowForm(false);
    setEditingId(null);
  };

  const handleEdit = (metric) => {
    try {
      setFormData({
        month: metric.month || 'January',
        week: metric.week || '1',
        year: metric.year || new Date().getFullYear().toString(),
        qualifiedConversations: (metric.qualifiedConversations || 0).toString(),
        bookedCalls: (metric.bookedCalls || 0).toString(),
        closedDeals: (metric.closedDeals || 0).toString(),
        cashCollected: (metric.cashCollected || 0).toString(),
        leadSource: metric.leadSource || 'Inbound'
      });
      setEditingId(metric.id);
      setShowForm(true);
      setShowDataTable(false);
    } catch (error) {
      alert('Error editing entry: ' + error.message);
    }
  };

  const handleDelete = async (id) => {
    try {
      const metric = metrics.find(m => m.id === id);
      const confirmed = window.confirm(`Delete entry for ${metric?.weekLabel || 'this week'}?`);
      if (confirmed) {
        const updatedMetrics = metrics.filter(m => m.id !== id);
        setMetrics(updatedMetrics);
        await saveMetrics(updatedMetrics);
      }
    } catch (error) {
      alert('Error deleting: ' + error.message);
    }
  };

  const handleClearAll = async () => {
    const confirmed = window.confirm('⚠️ WARNING: This will DELETE ALL DATA permanently. Are you absolutely sure?');
    if (confirmed) {
      const doubleCheck = window.confirm('This is your last chance. Delete everything?');
      if (doubleCheck) {
        setMetrics([]);
        await saveMetrics([]);
        setShowDataTable(false);
        alert('All data has been cleared');
      }
    }
  };

  const getFilteredMetrics = () => {
    if (viewMode === 'all') return metrics;
    
    if (viewMode.startsWith('q')) {
      const quarter = viewMode.toUpperCase();
      const quarterMonths = quarters[quarter];
      return metrics.filter(m => quarterMonths.includes(m.month));
    }
    
    if (viewMode === 'monthly' && selectedMonth) {
      return metrics.filter(m => m.month === selectedMonth);
    }
    
    return metrics;
  };

  const getLeadSourceBreakdown = () => {
    const filtered = getFilteredMetrics();
    const breakdown = {};
    
    leadSources.forEach(source => {
      const sourceMetrics = filtered.filter(m => m.leadSource === source);
      breakdown[source] = {
        qualified: sourceMetrics.reduce((sum, m) => sum + m.qualifiedConversations, 0),
        booked: sourceMetrics.reduce((sum, m) => sum + m.bookedCalls, 0),
        closed: sourceMetrics.reduce((sum, m) => sum + m.closedDeals, 0),
        cash: sourceMetrics.reduce((sum, m) => sum + m.cashCollected, 0)
      };
    });
    
    return breakdown;
  };

  const getAggregatedMetrics = () => {
    const filtered = getFilteredMetrics();
    
    if (chartViewMode === 'yearly') {
      const grouped = {};
      filtered.forEach(m => {
        const key = m.year;
        if (!grouped[key]) {
          grouped[key] = {
            weekLabel: key,
            chartLabel: `'${key.substring(2)}`,
            qualifiedConversations: 0,
            bookedCalls: 0,
            closedDeals: 0,
            cashCollected: 0,
            count: 0
          };
        }
        grouped[key].qualifiedConversations += m.qualifiedConversations;
        grouped[key].bookedCalls += m.bookedCalls;
        grouped[key].closedDeals += m.closedDeals;
        grouped[key].cashCollected += m.cashCollected;
        grouped[key].count++;
      });
      
      return Object.values(grouped).map(g => ({
        ...g,
        ...calculateRates(g.qualifiedConversations, g.bookedCalls, g.closedDeals)
      }));
    }
    
    if (chartViewMode === 'quarterly') {
      const grouped = {};
      filtered.forEach(m => {
        let quarter = 'Q1';
        if (quarters.Q2.includes(m.month)) quarter = 'Q2';
        else if (quarters.Q3.includes(m.month)) quarter = 'Q3';
        else if (quarters.Q4.includes(m.month)) quarter = 'Q4';
        
        const key = `${quarter} ${m.year}`;
        if (!grouped[key]) {
          grouped[key] = {
            weekLabel: key,
            chartLabel: `${quarter} '${m.year.substring(2)}`,
            qualifiedConversations: 0,
            bookedCalls: 0,
            closedDeals: 0,
            cashCollected: 0,
            count: 0
          };
        }
        grouped[key].qualifiedConversations += m.qualifiedConversations;
        grouped[key].bookedCalls += m.bookedCalls;
        grouped[key].closedDeals += m.closedDeals;
        grouped[key].cashCollected += m.cashCollected;
        grouped[key].count++;
      });
      
      return Object.values(grouped).map(g => ({
        ...g,
        ...calculateRates(g.qualifiedConversations, g.bookedCalls, g.closedDeals)
      }));
    }
    
    if (chartViewMode === 'monthly') {
      const grouped = {};
      filtered.forEach(m => {
        const key = `${m.month} ${m.year}`;
        if (!grouped[key]) {
          grouped[key] = {
            weekLabel: key,
            chartLabel: `${m.month.substring(0, 3)} '${m.year.substring(2)}`,
            qualifiedConversations: 0,
            bookedCalls: 0,
            closedDeals: 0,
            cashCollected: 0,
            count: 0
          };
        }
        grouped[key].qualifiedConversations += m.qualifiedConversations;
        grouped[key].bookedCalls += m.bookedCalls;
        grouped[key].closedDeals += m.closedDeals;
        grouped[key].cashCollected += m.cashCollected;
        grouped[key].count++;
      });
      
      return Object.values(grouped).map(g => ({
        ...g,
        ...calculateRates(g.qualifiedConversations, g.bookedCalls, g.closedDeals)
      }));
    }
    
    // Weekly view (default)
    return filtered.map(m => ({
      ...m,
      chartLabel: `W${m.week}`
    }));
  };

  const getAIInsights = async () => {
    setLoadingInsights(true);
    const dataToAnalyze = getFilteredMetrics();
    const sourceBreakdown = getLeadSourceBreakdown();
    
    try {
      const response = await fetch('https://api.anthropic.com/v1/messages', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: 'claude-sonnet-4-20250514',
          max_tokens: 1500,
          messages: [{
            role: 'user',
            content: `You are a sales performance analyst. Analyze these sales metrics and provide structured, actionable insights.

Metrics data:
${JSON.stringify(dataToAnalyze, null, 2)}

Lead Source Breakdown:
${JSON.stringify(sourceBreakdown, null, 2)}

IMPORTANT: Structure your response EXACTLY as follows with these section headers:

## PERFORMANCE SUMMARY
[Brief 2-3 sentence overview of overall performance]

## KEY METRICS
- Total Revenue: [value]
- Average Booking Rate: [value]
- Average Conversion Rate: [value]
- Best Performing Source: [value]

## LEAD SOURCE ANALYSIS
[Analyze performance by Inbound, Outbound, and Referral]

## TRENDS & PATTERNS
[Identify important trends over time]

## AREAS OF CONCERN
[List specific problems or bottlenecks]

## TOP 3 RECOMMENDATIONS
1. [First recommendation with specific action]
2. [Second recommendation with specific action]
3. [Third recommendation with specific action]

## QUICK WINS
[List 2-3 easy improvements that can be implemented immediately]`
          }]
        })
      });

      const data = await response.json();
      const insightText = data.content[0].text;
      
      // Parse the structured response
      const sections = {
        summary: '',
        metrics: '',
        sources: '',
        trends: '',
        concerns: '',
        recommendations: '',
        quickWins: ''
      };
      
      const summaryMatch = insightText.match(/## PERFORMANCE SUMMARY\n([\s\S]*?)(?=\n## |$)/);
      const metricsMatch = insightText.match(/## KEY METRICS\n([\s\S]*?)(?=\n## |$)/);
      const sourcesMatch = insightText.match(/## LEAD SOURCE ANALYSIS\n([\s\S]*?)(?=\n## |$)/);
      const trendsMatch = insightText.match(/## TRENDS & PATTERNS\n([\s\S]*?)(?=\n## |$)/);
      const concernsMatch = insightText.match(/## AREAS OF CONCERN\n([\s\S]*?)(?=\n## |$)/);
      const recsMatch = insightText.match(/## TOP 3 RECOMMENDATIONS\n([\s\S]*?)(?=\n## |$)/);
      const quickMatch = insightText.match(/## QUICK WINS\n([\s\S]*?)(?=\n## |$)/);
      
      if (summaryMatch) sections.summary = summaryMatch[1].trim();
      if (metricsMatch) sections.metrics = metricsMatch[1].trim();
      if (sourcesMatch) sections.sources = sourcesMatch[1].trim();
      if (trendsMatch) sections.trends = trendsMatch[1].trim();
      if (concernsMatch) sections.concerns = concernsMatch[1].trim();
      if (recsMatch) sections.recommendations = recsMatch[1].trim();
      if (quickMatch) sections.quickWins = quickMatch[1].trim();
      
      setAiInsights(sections);
    } catch (error) {
      setAiInsights({ error: 'Error generating insights. Please try again.' });
    } finally {
      setLoadingInsights(false);
    }
  };

  const calculateTotals = () => {
    const filtered = getFilteredMetrics();
    return {
      totalCash: filtered.reduce((sum, m) => sum + m.cashCollected, 0),
      avgBookingRate: filtered.length > 0 ? filtered.reduce((sum, m) => sum + m.bookingRate, 0) / filtered.length : 0,
      avgConversionRate: filtered.length > 0 ? filtered.reduce((sum, m) => sum + m.conversionRate, 0) / filtered.length : 0,
      totalQualified: filtered.reduce((sum, m) => sum + m.qualifiedConversations, 0),
      totalBooked: filtered.reduce((sum, m) => sum + m.bookedCalls, 0),
      totalClosed: filtered.reduce((sum, m) => sum + m.closedDeals, 0)
    };
  };

  const currentRates = formData.qualifiedConversations && formData.bookedCalls && formData.closedDeals
    ? calculateRates(
        parseInt(formData.qualifiedConversations) || 0,
        parseInt(formData.bookedCalls) || 0,
        parseInt(formData.closedDeals) || 0
      )
    : { bookingRate: 0, conversionRate: 0 };

  if (loading) {
    return <div className={`flex items-center justify-center h-screen ${darkMode ? 'bg-black' : 'bg-white'}`}>
      <div className={`${darkMode ? 'text-white' : 'text-slate-900'} text-xl font-light tracking-wide`}>Loading...</div>
    </div>;
  }

  // Login/Setup Screen
  if (!isAuthenticated) {
    return (
      <div className={`min-h-screen flex items-center justify-center ${darkMode ? 'bg-black' : 'bg-white'} transition-colors duration-300`} style={{ fontFamily: '-apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif' }}>
        <div className="absolute top-8 right-8">
          <button
            onClick={toggleTheme}
            className={`p-3 rounded-full ${darkMode ? 'bg-zinc-800' : 'bg-slate-100'} hover:bg-opacity-80 transition`}
          >
            {darkMode ? <Sun className="w-5 h-5 text-orange-500" /> : <Moon className="w-5 h-5 text-slate-700" />}
          </button>
        </div>

        <div className="w-full max-w-md px-6">
          <div className="text-center mb-12">
            <div className="w-20 h-20 bg-orange-500 rounded-3xl mx-auto mb-6 flex items-center justify-center shadow-2xl">
              <Target className="w-10 h-10 text-white" />
            </div>
            <h1 className={`text-4xl font-semibold ${darkMode ? 'text-white' : 'text-slate-900'} mb-2 tracking-tight`}>
              Sales Dashboard
            </h1>
            <p className={`text-lg ${darkMode ? 'text-slate-400' : 'text-slate-600'} font-light`}>
              {isFirstTime ? 'Welcome! Set up your password' : 'Welcome back'}
            </p>
          </div>

          <div className={`${darkMode ? 'bg-zinc-900' : 'bg-white'} rounded-3xl p-8 shadow-2xl border ${darkMode ? 'border-zinc-800' : 'border-slate-200'}`}>
            {isFirstTime ? (
              <div className="space-y-6">
                <div>
                  <label className={`block text-sm font-medium ${darkMode ? 'text-slate-300' : 'text-slate-700'} mb-2`}>
                    Create Password
                  </label>
                  <input
                    type="password"
                    value={setupPassword}
                    onChange={(e) => setSetupPassword(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && document.getElementById('confirm-password').focus()}
                    placeholder="Enter a password (min 6 characters)"
                    className={`w-full px-4 py-3 rounded-xl ${darkMode ? 'bg-zinc-800 text-white border-zinc-700' : 'bg-slate-50 text-slate-900 border-slate-200'} border focus:outline-none focus:ring-2 focus:ring-orange-500 transition`}
                  />
                </div>
                <div>
                  <label className={`block text-sm font-medium ${darkMode ? 'text-slate-300' : 'text-slate-700'} mb-2`}>
                    Confirm Password
                  </label>
                  <input
                    id="confirm-password"
                    type="password"
                    value={confirmPassword}
                    onChange={(e) => setConfirmPassword(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && handleSetupPassword()}
                    placeholder="Re-enter your password"
                    className={`w-full px-4 py-3 rounded-xl ${darkMode ? 'bg-zinc-800 text-white border-zinc-700' : 'bg-slate-50 text-slate-900 border-slate-200'} border focus:outline-none focus:ring-2 focus:ring-orange-500 transition`}
                  />
                </div>
                {loginError && (
                  <div className="bg-red-500 bg-opacity-10 border border-red-500 border-opacity-20 rounded-xl p-3">
                    <p className="text-red-500 text-sm text-center">{loginError}</p>
                  </div>
                )}
                <button
                  onClick={handleSetupPassword}
                  className="w-full bg-orange-500 text-white px-6 py-3 rounded-xl font-medium hover:bg-orange-600 transition shadow-lg"
                >
                  Create Account
                </button>
              </div>
            ) : (
              <div className="space-y-6">
                <div>
                  <label className={`block text-sm font-medium ${darkMode ? 'text-slate-300' : 'text-slate-700'} mb-2`}>
                    Password
                  </label>
                  <input
                    type="password"
                    value={loginPassword}
                    onChange={(e) => setLoginPassword(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && handleLogin()}
                    placeholder="Enter your password"
