                      tickLine={false}
                      style={{ fontSize: '13px', fontWeight: '500' }} 
                    />
                    <YAxis 
                      stroke={darkMode ? '#52525b' : '#94a3b8'} 
                      axisLine={false}
                      tickLine={false}
                      style={{ fontSize: '13px', fontWeight: '500' }}
                      tickFormatter={(value) => `${value.toLocaleString()}`}
                    />
                    <Tooltip 
                      contentStyle={{ 
                        backgroundColor: darkMode ? '#09090b' : '#fff', 
                        border: 'none',
                        borderRadius: '16px',
                        padding: '12px 16px',
                        boxShadow: '0 10px 40px rgba(0,0,0,0.1)'
                      }}
                      formatter={(value) => [`${value.toLocaleString()}`, 'Revenue']}
                      labelStyle={{ color: darkMode ? '#fff' : '#000', fontWeight: '600', marginBottom: '4px' }}
                    />
                    <Line 
                      type="monotone" 
                      dataKey="cashCollected" 
                      stroke="#FF6B35" 
                      strokeWidth={3} 
                      dot={{ fill: '#FF6B35', r: 5, strokeWidth: 2, stroke: darkMode ? '#000' : '#fff' }}
                      activeDot={{ r: 7 }}
                      fill="url(#colorRevenue)"
                    />
                  </LineChart>
                </ResponsiveContainer>
              </div>

              {/* Overview Charts Grid */}
              <div className="grid grid-cols-3 gap-6">
                <div className={`${cardBg} rounded-2xl p-6 border ${borderClass}`}>
                  <h4 className={`text-sm font-semibold ${textClass} mb-4`}>Conversion Rates</h4>
                  <ResponsiveContainer width="100%" height={180}>
                    <LineChart data={chartData} margin={{ top: 5, right: 5, left: -20, bottom: 5 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke={darkMode ? '#27272a' : '#f1f5f9'} vertical={false} />
                      <XAxis 
                        dataKey="chartLabel" 
                        stroke={darkMode ? '#52525b' : '#94a3b8'} 
                        axisLine={false}
                        tickLine={false}
                        style={{ fontSize: '11px' }} 
                      />
                      <YAxis 
                        stroke={darkMode ? '#52525b' : '#94a3b8'} 
                        axisLine={false}
                        tickLine={false}
                        style={{ fontSize: '11px' }}
                        tickFormatter={(value) => `${value}%`}
                      />
                      <Tooltip 
                        contentStyle={{ 
                          backgroundColor: darkMode ? '#09090b' : '#fff', 
                          border: 'none',
                          borderRadius: '12px',
                          padding: '8px 12px',
                          boxShadow: '0 10px 40px rgba(0,0,0,0.1)',
                          fontSize: '12px'
                        }}
                        formatter={(value) => `${value.toFixed(1)}%`}
                        labelFormatter={(label, payload) => {
                          if (payload && payload[0]) {
                            return payload[0].payload.weekLabel || label;
                          }
                          return label;
                        }}
                      />
                      <Line type="monotone" dataKey="bookingRate" stroke="#FF6B35" strokeWidth={2} name="Booking" dot={false} />
                      <Line type="monotone" dataKey="conversionRate" stroke="#9B59B6" strokeWidth={2} name="Conversion" dot={false} />
                    </LineChart>
                  </ResponsiveContainer>
                </div>

                <div className={`${cardBg} rounded-2xl p-6 border ${borderClass}`}>
                  <h4 className={`text-sm font-semibold ${textClass} mb-4`}>Pipeline Activity</h4>
                  <ResponsiveContainer width="100%" height={180}>
                    <BarChart data={chartData} margin={{ top: 5, right: 5, left: -20, bottom: 5 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke={darkMode ? '#27272a' : '#f1f5f9'} vertical={false} />
                      <XAxis 
                        dataKey="chartLabel" 
                        stroke={darkMode ? '#52525b' : '#94a3b8'} 
                        axisLine={false}
                        tickLine={false}
                        style={{ fontSize: '11px' }} 
                      />
                      <YAxis 
                        stroke={darkMode ? '#52525b' : '#94a3b8'} 
                        axisLine={false}
                        tickLine={false}
                        style={{ fontSize: '11px' }}
                      />
                      <Tooltip 
                        contentStyle={{ 
                          backgroundColor: darkMode ? '#09090b' : '#fff', 
                          border: 'none',
                          borderRadius: '12px',
                          padding: '8px 12px',
                          boxShadow: '0 10px 40px rgba(0,0,0,0.1)',
                          fontSize: '12px'
                        }}
                        labelFormatter={(label, payload) => {
                          if (payload && payload[0]) {
                            return payload[0].payload.weekLabel || label;
                          }
                          return label;
                        }}
                      />
                      <Bar dataKey="qualifiedConversations" fill="#FF6B35" name="Qualified" radius={[6, 6, 0, 0]} />
                      <Bar dataKey="bookedCalls" fill="#9B59B6" name="Booked" radius={[6, 6, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>

                <div className={`${cardBg} rounded-2xl p-6 border ${borderClass}`}>
                  <h4 className={`text-sm font-semibold ${textClass} mb-4`}>Closed Deals</h4>
                  <ResponsiveContainer width="100%" height={180}>
                    <BarChart data={chartData} margin={{ top: 5, right: 5, left: -20, bottom: 5 }}>
                      <CartesianGrid strokeDasharray="3 3" stroke={darkMode ? '#27272a' : '#f1f5f9'} vertical={false} />
                      <XAxis 
                        dataKey="chartLabel" 
                        stroke={darkMode ? '#52525b' : '#94a3b8'} 
                        axisLine={false}
                        tickLine={false}
                        style={{ fontSize: '11px' }} 
                      />
                      <YAxis 
                        stroke={darkMode ? '#52525b' : '#94a3b8'} 
                        axisLine={false}
                        tickLine={false}
                        style={{ fontSize: '11px' }}
                      />
                      <Tooltip 
                        contentStyle={{ 
                          backgroundColor: darkMode ? '#09090b' : '#fff', 
                          border: 'none',
                          borderRadius: '12px',
                          padding: '8px 12px',
                          boxShadow: '0 10px 40px rgba(0,0,0,0.1)',
                          fontSize: '12px'
                        }}
                        labelFormatter={(label, payload) => {
                          if (payload && payload[0]) {
                            return payload[0].payload.weekLabel || label;
                          }
                          return label;
                        }}
                      />
                      <Bar dataKey="closedDeals" fill="#2ECC71" name="Closed" radius={[6, 6, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>
              </div>
            </div>

            {/* AI Insights */}
            <div className={`${cardBg} rounded-3xl p-8 border ${borderClass}`}>
              <div className="flex items-center justify-between mb-6">
                <div className="flex items-center gap-3">
                  <div className="w-12 h-12 bg-orange-500 bg-opacity-10 rounded-full flex items-center justify-center">
                    <Sparkles className="w-6 h-6 text-orange-500" />
                  </div>
                  <div>
                    <h2 className={`text-2xl font-semibold ${textClass}`}>AI Insights</h2>
                    <p className={`text-sm ${textSecondary} font-light`}>Powered by Claude</p>
                  </div>
                </div>
                <button
                  onClick={getAIInsights}
                  disabled={loadingInsights}
                  className="bg-orange-500 text-white px-6 py-3 rounded-full font-medium hover:bg-orange-600 transition disabled:opacity-50 shadow-lg"
                >
                  {loadingInsights ? 'Analyzing...' : 'Generate Insights'}
                </button>
              </div>
              
              {aiInsights && !aiInsights.error ? (
                <div className="space-y-6">
                  {aiInsights.summary && (
                    <div className={`${darkMode ? 'bg-zinc-800' : 'bg-orange-50'} rounded-2xl p-6 border ${darkMode ? 'border-zinc-700' : 'border-orange-200'}`}>
                      <h3 className={`text-lg font-semibold ${textClass} mb-3`}>Performance Summary</h3>
                      <p className={`${textSecondary} font-light leading-relaxed`}>{aiInsights.summary}</p>
                    </div>
                  )}
                  
                  {aiInsights.metrics && (
                    <div className={`${darkMode ? 'bg-zinc-800' : 'bg-slate-50'} rounded-2xl p-6 border ${borderClass}`}>
                      <h3 className={`text-lg font-semibold ${textClass} mb-3`}>Key Metrics</h3>
                      <div className={`${textSecondary} font-light whitespace-pre-line`}>{aiInsights.metrics}</div>
                    </div>
                  )}
                  
                  {aiInsights.recommendations && (
                    <div className={`${darkMode ? 'bg-zinc-800' : 'bg-slate-50'} rounded-2xl p-6 border ${borderClass}`}>
                      <h3 className={`text-lg font-semibold ${textClass} mb-3 flex items-center gap-2`}>
                        <Target className="w-5 h-5 text-orange-500" />
                        Top Recommendations
                      </h3>
                      <div className={`${textSecondary} font-light whitespace-pre-line`}>{aiInsights.recommendations}</div>
                    </div>
                  )}
                  
                  {aiInsights.quickWins && (
                    <div className="bg-orange-500 bg-opacity-10 rounded-2xl p-6 border border-orange-500 border-opacity-20">
                      <h3 className={`text-lg font-semibold text-orange-500 mb-3`}>Quick Wins</h3>
                      <div className={`${textSecondary} font-light whitespace-pre-line`}>{aiInsights.quickWins}</div>
                    </div>
                  )}
                  
                  <div className="grid grid-cols-2 gap-6">
                    {aiInsights.sources && (
                      <div className={`${darkMode ? 'bg-zinc-800' : 'bg-slate-50'} rounded-2xl p-6 border ${borderClass}`}>
                        <h3 className={`text-lg font-semibold ${textClass} mb-3`}>Lead Source Analysis</h3>
                        <div className={`${textSecondary} font-light whitespace-pre-line text-sm`}>{aiInsights.sources}</div>
                      </div>
                    )}
                    
                    {aiInsights.concerns && (
                      <div className={`${darkMode ? 'bg-zinc-800' : 'bg-slate-50'} rounded-2xl p-6 border ${borderClass}`}>
                        <h3 className={`text-lg font-semibold ${textClass} mb-3`}>Areas of Concern</h3>
                        <div className={`${textSecondary} font-light whitespace-pre-line text-sm`}>{aiInsights.concerns}</div>
                      </div>
                    )}
                  </div>
                </div>
              ) : aiInsights?.error ? (
                <div className="text-center py-8">
                  <p className="text-red-500">{aiInsights.error}</p>
                </div>
              ) : (
                <div className="text-center py-12">
                  <p className={`${textSecondary} font-light`}>Click "Generate Insights" to get AI-powered analysis</p>
                </div>
              )}
            </div>
          </>
        )}
      </div>
    </div>
  );
}
